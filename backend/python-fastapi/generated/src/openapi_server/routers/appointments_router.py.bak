from fastapi import APIRouter, Depends, HTTPException, status
from typing import List
from pydantic import BaseModel
from datetime import datetime
from openapi_server.security_api import get_token_bearerAuth, TokenModel
from openapi_server.dependencies import get_current_user

router = APIRouter(prefix="/appointments", tags=["appointments"])

# Simulação de banco de dados em memória
FAKE_APPOINTMENTS: List["Appointment"] = []

# Modelo Pydantic atualizado para o app
class Appointment(BaseModel):
    id: int
    donor_email: str
    center_id: int
    center_name: str
    start_time: datetime
    end_time: datetime
    status: str = "confirmed"

# Modelo de criação (enviado pelo app)
class AppointmentCreate(BaseModel):
    center_id: int
    center_name: str
    start_time: datetime
    end_time: datetime


@router.get("/", response_model=List[Appointment])
async def list_appointments(token_bearerAuth: TokenModel = Depends(get_token_bearerAuth)):
    """
    Lista os agendamentos do usuário autenticado
    """
    user_email = token_bearerAuth.sub
    return [a for a in FAKE_APPOINTMENTS if a.donor_email == user_email]


@router.post("/", response_model=Appointment, status_code=status.HTTP_201_CREATED)
async def create_appointment(
    appointment_data: AppointmentCreate,
    token_bearerAuth: TokenModel = Depends(get_token_bearerAuth)
):
    """
    Cria um novo agendamento (necessita autenticação)
    """
    user_email = token_bearerAuth.sub
    if not user_email:
        raise HTTPException(status_code=403, detail="Not authenticated")

    new_appointment = Appointment(
        id=len(FAKE_APPOINTMENTS) + 1,
        donor_email=user_email,
        center_id=appointment_data.center_id,
        center_name=appointment_data.center_name,
        start_time=appointment_data.start_time,
        end_time=appointment_data.end_time,
        status="confirmed",
    )
    FAKE_APPOINTMENTS.append(new_appointment)
    return new_appointment


@router.delete("/{appointment_id}")
async def delete_appointment(
    appointment_id: int,
    token_bearerAuth: TokenModel = Depends(get_token_bearerAuth),
):
    """
    Cancela um agendamento existente
    """
    global FAKE_APPOINTMENTS
    user_email = token_bearerAuth.sub
    FAKE_APPOINTMENTS = [
        a for a in FAKE_APPOINTMENTS if not (a.id == appointment_id and a.donor_email == user_email)
    ]
    return {"message": f"Agendamento #{appointment_id} cancelado com sucesso."}